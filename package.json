{
  "name": "automation-the-internet",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf allure-results allure-report",
    "test": "cross-env ALLURE=true mocha tests/*.js --timeout 21000 --reporter allure-mocha",
    "report": "allure generate allure-results --clean -o allure-report",
    "open": "allure open allure-report",
    "clean:test:allure": "npm run clean && npm test && npm run report && npm run open",
    "test:allure": "npm test && npm run report && npm run open"

  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Olexandr29/automation-the-internet-js.git"
  },
