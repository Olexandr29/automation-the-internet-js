  },
  "homepage": "https://github.com/Olexandr29/automation-the-internet-js#readme",
  "devDependencies": {
    "allure-mocha": "^3.10.2",
    "cross-env": "^10.1.0",
    "mocha": "^11.7.6",
    "rimraf": "^6.1.3",
    "selenium-webdriver": "^4.45.0"
  }
}
